[0.288, "o", "\u001b[34m==>\u001b[0m \u001b[1mPouring oidc-agent-5.3.4.arm64_sequoia.bottle.tar.gz\u001b[0m\r\n"]
[0.296, "o", "\u001b[34m==>\u001b[0m \u001b[1mCaveats\u001b[0m\r\nTo start oidc-agent as a background service now and restart at login:\r\n  brew services start oidc-agent\r\nIf you don't need a background service, you can run the following instead:\r\n  oidc-agent -a ~/Library/Caches/oidc-agent/oidc-agent.sock -d\r\n\r\nTo start indigo-dc/oidc-agent/oidc-agent now and restart at login:\r\n  brew services start indigo-dc/oidc-agent/oidc-agent\r\nOr, if you don't want/need a background service you can just run:\r\n  /opt/homebrew/opt/oidc-agent/bin/oidc-agent -a /Users/hpci000000/Library/Caches/oidc-agent/oidc-agent.sock -d\r\n"]
[0.001, "o", "\u001b[34m==>\u001b[0m \u001b[1mSummary\u001b[0m\r\n"]
[0.000, "o", "🍺  /opt/homebrew/Cellar/oidc-agent/5.3.4: 50 files, 1.8MB\r\n"]
[0.001, "o", "\u001b[34m==>\u001b[0m \u001b[1mRunning `brew cleanup oidc-agent`...\u001b[0m\r\n"]
[0.000, "o", "Disable this behaviour by setting `HOMEBREW_NO_INSTALL_CLEANUP=1`.\r\nHide these hints with `HOMEBREW_NO_ENV_HINTS=1` (see `man brew`).\r\n"]
[0.010, "o", "\u001b[32m==>\u001b[0m \u001b[1mCaveats\u001b[0m\r\n"]
[0.000, "o", "\u001b[34m==>\u001b[0m \u001b[1moidc-agent\u001b[0m\r\nTo start oidc-agent as a background service now and restart at login:\r\n  brew services start oidc-agent\r\nIf you don't need a background service, you can run the following instead:\r\n  oidc-agent -a ~/Library/Caches/oidc-agent/oidc-agent.sock -d\r\n\r\nTo start indigo-dc/oidc-agent/oidc-agent now and restart at login:\r\n  brew services start indigo-dc/oidc-agent/oidc-agent\r\nOr, if you don't want/need a background service you can just run:\r\n  /opt/homebrew/opt/oidc-agent/bin/oidc-agent -a /Users/hpci000000/Library/Caches/oidc-agent/oidc-agent.sock -d\r\n"]
