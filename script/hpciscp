#!@bash_path@

set -eu

source "${pkglibexecdir:-@pkglibexecdir@}"/hpcissh-lib

usage() {
    echo "Usage: ${0} [scp command option] [[user@]host1:]file1 ... [[user@]host2:]file2"
}

init_common "${@}"
get_token

# shellcheck disable=SC2154
: "${HPCISSH_PORT}"

SCP_CMD="${SCP_CMD:-scp}"

RAW_ARGV=("${SCP_CMD}")
RAW_ARGV+=("${@}")

ARGV=()
CONVERTED_SCP_ARG=$(convert_scp_arg "${RAW_ARGV[@]}")
while IFS= read -r arg; do
    ARGV+=("${arg}")
done <<< "${CONVERTED_SCP_ARG}"
ARGV=("${ARGV[@]:1}")

set +e
runssh "${SCP_CMD}" -P "${HPCISSH_PORT}" "${SSH_BASIC_OPTS[@]}" "${ARGV[@]}"
RESULT="${?}"
verify_hostname "${RESULT}"
set -e
exit "${RESULT}"
