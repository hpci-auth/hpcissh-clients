#!@bash_path@

set -eu

source "${pkglibexecdir:-@pkglibexecdir@}"/hpcissh-lib
load_common_config

PARENT_CMD=$(ps -p "${PPID}" -o comm=)
PARENT_CMD=$(basename -- "${PARENT_CMD}" | tr -d '-')
HPCISSH_SHELL_TYPE="${HPCISSH_SHELL_TYPE:-}"

if [[ -n "${HPCISSH_SHELL_TYPE}" ]]; then
    case "${HPCISSH_SHELL_TYPE}" in
        csh|tcsh) DETECTED_SHELL="csh" ;;
        *)        DETECTED_SHELL="sh"  ;;
    esac
else
    case "${PARENT_CMD}" in
        csh|tcsh) DETECTED_SHELL="csh" ;;
        *)        DETECTED_SHELL="sh"  ;;
    esac
fi
# Overridable
OIDC_AGENT_SERVICE="${OIDC_AGENT_SERVICE:-oidc-agent-service}"

# Find oidc-agent dir
# (SEE ALSO: oidc-agent-service)
if [[ -n "${OIDC_CONFIG_DIR:-}" ]]; then
    if [[ ! -d "${OIDC_CONFIG_DIR}" ]]; then
        ERROR "${OIDC_CONFIG_DIR}: No such directory"
        exit 1
    fi
    MY_OIDC_CONFIG_DIR="${OIDC_CONFIG_DIR}"
else
    MY_OIDC_CONFIG_DIR="${HOME}/.config/oidc-agent"
    if [[ ! -d "${MY_OIDC_CONFIG_DIR}" ]] && [[ -d "${HOME}/.oidc-agent" ]]; then
        MY_OIDC_CONFIG_DIR="${HOME}/.oidc-agent"
    fi
fi

mkdir -p "${MY_OIDC_CONFIG_DIR}/issuer.config.d/"

# Detect oidc-agent major version
# oidc-agent --version outputs e.g. "oidc-agent 5.3.4"
_oidc_agent_version=$(oidc-agent --version 2>/dev/null | awk '{print $2}')
_oidc_agent_major=$(echo "${_oidc_agent_version}" | cut -d. -f1)
if [[ -z "${_oidc_agent_major}" ]]; then
    DEBUG "Failed to detect oidc-agent version; applying both v4 and v5 configurations"
else
    DEBUG "oidc-agent version: ${_oidc_agent_version} (major: ${_oidc_agent_major})"
fi

# For oidc-agent v5+
_setup_v5() {
    check_and_copy() {
        local src="${1}"
        local dst="${2}"

        if [[ -L "${dst}" ]]; then
            ERROR "${dst}: is a symbolic link; remove it manually before proceeding"
            exit 1
        fi

        if [[ ! -e "${dst}" ]] || ! cmp -s "${src}" "${dst}"; then
            INFO "Copying ${src} to ${dst}"
            cp "${src}" "${dst}"
        else
            DEBUG "No changes in ${dst}"
        fi
    }
    check_and_copy "@pkgdatadir@/oidc-agent_hpci-main.conf" "${MY_OIDC_CONFIG_DIR}/issuer.config.d/hpci-main"
    check_and_copy "@pkgdatadir@/oidc-agent_hpci-sub.conf"  "${MY_OIDC_CONFIG_DIR}/issuer.config.d/hpci-sub"
}

# For oidc-agent v4 (and below)
_setup_v4() {
    append_line_if_missing() {
        local line="${1}"
        local file="${2}"

        if [[ ! -e "${file}" ]]; then
            touch "${file}"
        fi
        if grep -qxF "${line}" "${file}"; then
            DEBUG "Already exists in ${file}: ${line}"
        else
            echo "${line}" >> "${file}"
            INFO "Added to ${file}: ${line}"
        fi
    }
    PUBCLIENTS_V4_HPCI="@pkgdatadir@/oidc-agent-v4_hpci-pubclients.config"
    PUBCLIENTS_V4_CONFIG="${MY_OIDC_CONFIG_DIR}/pubclients.config"
    while read -r line || [[ -n "${line}" ]]; do
        append_line_if_missing "${line}" "${PUBCLIENTS_V4_CONFIG}"
    done < "${PUBCLIENTS_V4_HPCI}"
}

if [[ -z "${_oidc_agent_major}" ]]; then
    _setup_v5
    _setup_v4
elif [[ "${_oidc_agent_major}" -ge 5 ]]; then
    _setup_v5
else
    _setup_v4
fi

# (Example of OPERATION=use)
# OIDC_SOCK=/var/folders/6d/dlm7c25j26l60wzvj58ndrmr0000gn/T//oidc-agent-service-501/oidc-agent.sock; export OIDC_SOCK;
# OIDCD_PID=11593; export OIDCD_PID;
# OIDCD_PID_FILE=/var/folders/6d/dlm7c25j26l60wzvj58ndrmr0000gn/T//oidc-agent-service-501/oidc-agent.pid; export OIDCD_PID_FILE;
# /bin/cat /var/folders/6d/dlm7c25j26l60wzvj58ndrmr0000gn/T//oidc-agent-service-501/oidc-agent.pid

# (Example of OPERATION=stop)
# unset OIDC_SOCK;
# unset OIDCD_PID;
# unset OIDCD_PID_FILE;

OPERATION="${1:-}"

# from hpcissh-lib
DEBUG "OIDC_AGENT_OPTS=${OIDC_AGENT_OPTS}"
export OIDC_AGENT_OPTS

case "${DETECTED_SHELL}" in
    csh )
        case "${OPERATION}" in
            stop | kill)
                if [[ -z "${OIDCD_PID_FILE:-}" ]]; then
                    exit 0
                fi
                OIDCD_PID=$(cat "${OIDCD_PID_FILE}")
                ;;
            *)
                ;;
        esac
        set +e
        # Avoid SC2312 while maintaining eval functionality
        OIDC_AGENT_SERVICE_OUT=$("${OIDC_AGENT_SERVICE}" "${@}")
        eval "${OIDC_AGENT_SERVICE_OUT}" >&2
        ret="${?}"
        if [[ "${ret}" -ne 0 ]]; then
            exit "${ret}"
        fi
        case "${OPERATION}" in
            use | start | restart | restart-s )
                OIDCD_PID=$(cat "${OIDCD_PID_FILE}")
                echo "setenv OIDC_SOCK ${OIDC_SOCK};"
                echo "setenv OIDCD_PID ${OIDCD_PID};"
                echo "setenv OIDCD_PID_FILE ${OIDCD_PID_FILE};"
                ;;
            stop | kill)
                # echo "Agent pid ${OIDCD_PID} killed;" >&2
                echo "unsetenv OIDC_SOCK;"
                echo "unsetenv OIDCD_PID;"
                echo "unsetenv OIDCD_PID_FILE;"
                ;;
            *)
                ;;
        esac
        exit "${ret}"
        ;;
    * )
        #exec bash -x `which "${OIDC_AGENT_SERVICE}"` "${@}"
        exec "${OIDC_AGENT_SERVICE}" "${@}"
        ;;
esac
