#!@bash_path@

set -eu -o pipefail
shopt -s inherit_errexit

VERSION="1.12.0 (2026-04-??)"

CA_PUB_FILE="@pkgdatadir@/known_hosts-HPCI-SSH_CA.txt"
CAT_CMD="${CAT_CMD:-/bin/cat}"

# ssh options for hpcissh,hpciscp,hpcisftp
KNOWN_HOSTS_CMD=("-o" "KnownHostsCommand=${CAT_CMD} '${CA_PUB_FILE}'")
SSH_BASIC_OPTS=("-o" "PreferredAuthentications=keyboard-interactive")
SSH_BASIC_OPTS+=("-o" "NumberOfPasswordPrompts=1")
SSH_OPTS=()

# for hpcissh
FORWARD_BEHAVIOR=("-o" "ExitOnForwardFailure=yes")

OAUTH_SSH_AT_PROMPT="Enter your OAuth token:"

HPCISSH_CONF="${HPCISSH_CONF:-${HOME}/.hpcissh}"
HPCISSH_LOCAL_ACCOUNTS="${HPCISSH_CONF}.local_accounts"

# TEST CASE:
# - setup:
#   - HPCISSH_DEBUG=yes
# - touch -t $(date -d "-43100 seconds" +%Y%m%d%H%M.%S) .hpcissh.local_accounts
#   - DEBUG: USE cached userinfo
# - touch -t $(date -d "-43300 seconds" +%Y%m%d%H%M.%S) .hpcissh.local_accounts
#   - DEBUG: DOWNLOAD userinfo

DEBUG() {
    if [[ "${HPCISSH_DEBUG:-no}" = "yes" ]]; then
        echo >&2 "DEBUG:" "$@"
    fi
}

INFO() {
    echo >&2 "INFO:" "$@"
}

WARN() {
    if [[ "${HPCISSH_QUIET:-no}" = "no" ]]; then
        echo >&2 "WARNING:" "$@"
    fi
}

ERROR() {
    echo >&2 "ERROR:" "$@"
}

FATAL() {
    echo >&2 "ERROR:" "$@"
    exit 1
}

print_message_expired_refresh_token_for_oidc_agent() {
    ERROR "(Expired or invalid refresh token)"
    INFO "Run the following commands to log in again:"
    INFO "    $ oidc-sshconf-hpci"
}

run_quiet() {
    local rv=0
    if [[ "${HPCISSH_DEBUG}" = "yes" ]]; then
        "$@" || rv=$?
    else
        "$@" 2> /dev/null || rv=$?
    fi
    if [[ ${rv} -ne 0 ]]; then
        ERROR "Command failed (exit ${rv}): '$*'"
    fi
    return "${rv}"
}

_get_token() {
    local CHECK_EXPIRED="${1}"
    unset OIDC_AT_DECODED 2> /dev/null || :

    # global
    OIDC_AT="${OIDC_AT:-}"
    if [[ -n "${OIDC_AT}" ]]; then
        DEBUG "OIDC_AT: use OIDC_AT (access token) environment variable"
        return 0
    fi

    # SEE ALSO:
    #   https://github.com/oss-tsukuba/jwt-agent
    #   https://oss-tsukuba.org/share/doc/gfarm/html/ja/user/auth-sasl.html
    # ex. /tmp/jwt_user_u1000/token.jwt

    OIDC_AT_JWT_AGENT=""

    # shellcheck disable=SC2154
    : "${USE_JWT_AGENT}"
    DEBUG "USE_JWT_AGENT=${USE_JWT_AGENT}"
    if [[ "${USE_JWT_AGENT}" = "yes" ]]; then  # use jwt-agent
        local token_file="${JWT_USER_PATH:-}"

        if [[ -n "${token_file}" ]] && [[ -r "${token_file}" ]]; then
            DEBUG "OIDC_AT: use JWT_USER_PATH (${token_file})"
            OIDC_AT=$(cat "${token_file}")
        fi
        if [[ -z "${OIDC_AT}" ]]; then
            local uid
            uid=$(id -u)
            token_file="/tmp/jwt_user_u${uid}/token.jwt"
            if [[ -r "${token_file}" ]]; then
                DEBUG "OIDC_AT: use ${token_file}"
                OIDC_AT=$(cat "${token_file}")
            fi
        fi
        if [[ -n "${OIDC_AT}" ]]; then
            # global
            OIDC_AT_DECODED=$(decode_jwt | jq .)
            # shellcheck disable=SC2310
            if is_jwt_expired; then
                OIDC_AT_JWT_AGENT="${OIDC_AT}"
                OIDC_AT=""  # To use oidc-agent
            fi
        fi
    fi
    if [[ -z "${OIDC_AT}" ]] && [[ -n "${OIDC_SOCK:-}" ]]; then  # use oidc-agent
        # shellcheck disable=SC2154
        : "${OIDC_AT_LEAST_VALID_TIME}"
        # shellcheck disable=SC2154
        : "${OIDC_AGENT_CONF_NAME}"

        # shellcheck disable=SC2310
        if OIDC_AT=$(run_quiet oidc-token -t "${OIDC_AT_LEAST_VALID_TIME}" "${OIDC_AGENT_CONF_NAME}"); then
            DEBUG "OIDC_AT: use oidc-token command"
        else
            print_message_expired_refresh_token_for_oidc_agent
            return 1  # error
        fi
    fi

    if [[ -z "${OIDC_AT}" ]]; then
       # Set expired token from jwt-agent
       OIDC_AT="${OIDC_AT_JWT_AGENT}"
    fi
    if [[ -z "${OIDC_AT}" ]]; then
        ERROR "Access token cannot be found. jwt-agent or oidc-agent is required."
        return 1  # error
    fi

    # global
    OIDC_AT_DECODED=$(decode_jwt | jq .)
    if [[ "${CHECK_EXPIRED}" = "true" ]]; then
        # shellcheck disable=SC2310
        if is_jwt_expired; then
            WARN "Expired access token is found."
            # not error
        fi
    fi

    # shellcheck disable=SC2154
    if [[ -n "${OIDC_USERINFO_ENDPOINT}" ]]; then
        _USERINFO_ENDPOINT="${OIDC_USERINFO_ENDPOINT}"
    else
        _ISSUER=$(get_claim iss)
        # shellcheck disable=SC2154
        _USERINFO_ENDPOINT="${_ISSUER}${OIDC_USERINFO_ENDPOINT_PATH}"
    fi
}

get_token() {
    _get_token true
}

get_token_ignore_expired() {
    _get_token false
}

init_sshpass() {
    if [[ -z "${SSHPASS:-}" ]]; then
        export SSHPASS="${OIDC_AT}"
    fi
    DEBUG "init_sshpass"
}

init_SSH_ASKPASS() {
    export OIDC_AT  # to get environment variable in hpci-token
    export SSH_ASKPASS=hpci-token
    export SSH_ASKPASS_REQUIRE=force
    export DISPLAY="${DISPLAY-DUMMY:0}"
    DEBUG "init_SSH_ASKPASS"
}

run_setsid_wait() {
    if command -v setsid > /dev/null 2>&1; then
        setsid -w "$@"
    else
        perl -e '
            use strict;
            use warnings;
            use POSIX qw(setsid);
            my $pid = fork;
            die "fork: $!" unless defined $pid;
            if ($pid == 0) {
                setsid() or die "setsid: $!";
                exec { $ARGV[0] } @ARGV or die "exec: $!";
            }
            waitpid($pid, 0);
            exit( ($? & 127) ? 128 + ($? & 127) : ($? >> 8) );
        ' -- "$@"
        # Replicate POSIX waitpid() status macros:
        #   ($? & 127)  => WIFSIGNALED / WTERMSIG (Return 128+signum)
        #   ($? >> 8)   => WEXITSTATUS
    fi
}

runssh() {
    # shellcheck disable=SC2154
    if [[ "${HPCISSH_TOKEN_INPUT}" = "SSH_ASKPASS" ]]; then
        init_SSH_ASKPASS
        run_setsid_wait "$@"
    else
        init_sshpass
        sshpass -e -P "${OAUTH_SSH_AT_PROMPT}" "$@"
    fi
}

permission_bits() {
    if stat --version &> /dev/null; then
        # GNU stat(1)
        stat -c %a "${1}"
    else
        # BSD, macOS
        stat -f %Lp "${1}"
    fi
}

check_perm() {
    local CONF="${1}"

    # owner?
    [[ -O "${CONF}" ]] || return 1

    # is writable by others?
    local writable
    writable=$(( 8#$(permission_bits "${CONF}") & ~8#0755 ))
    [[ "${writable}" = "0" ]] || return 1
}

HPCISSH_PARAM_KEY_LIST=()

set_param() {
    local name="${1}"
    local default_val="${2}"

    HPCISSH_PARAM_KEY_LIST+=("${name}")
    local num="${#HPCISSH_PARAM_KEY_LIST[@]}"

    # For example, this is the same as HPCISSH_DEBUG_X=${HPCISSH_DEBUG_X:-no}
    if [[ -v "${name}" ]]; then
        declare -g "${name}=${!name}"
        DEBUG "set_param[num=${num}]: ${name}=\"${!name}\" (customized {default:${default_val}})"
    else
        declare -g "${name}=${default_val}"
        DEBUG "set_param[num=${num}]: ${name}=\"${!name}\" (use default)"
    fi
}

config_show() {
    local key
    for key in "${HPCISSH_PARAM_KEY_LIST[@]}"; do
        if [[ -v "${key}" ]]; then
            echo "${key}=\"${!key}\""
        fi
    done
}

load_common_config() {
    # Load user configuration
    if [[ -f "${HPCISSH_CONF}" ]]; then
        # shellcheck disable=SC2310
        if ! check_perm "${HPCISSH_CONF}"; then
            ERROR "${HPCISSH_CONF} is writable by others.  Run 'chmod 600 ${HPCISSH_CONF}'."
            exit 1
        fi
        # Overridable by environment variables
        while read -r line || [[ -n "${line}" ]]; do
            # Skip comments and empty lines
            [[ "${line}" =~ ^[[:space:]]*# ]] && continue
            [[ "${line}" =~ ^[[:space:]]*$ ]] && continue
            [[ "${line}" != *"="* ]] && continue

            local key="${line%%=*}"
            local val="${line#*=}"

            # Trim leading/trailing whitespace
            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            val="${val#"${val%%[![:space:]]*}"}"
            val="${val%"${val##*[![:space:]]}"}"

            # Remove surrounding double quotes from value
            if [[ "${val}" =~ ^\".*\"$ ]]; then
                val="${val#\"}"
                val="${val%\"}"
            fi

            # skip semicolon (security measure)
            [[ "${key}" =~ [\;] ]] && FATAL "${HPCISSH_CONF}: Invalid key: ${key}"
            [[ "${val}" =~ [\;] ]] && FATAL "${HPCISSH_CONF}: Invalid value: ${val}"

            if [[ -v "${key}" ]]; then
                DEBUG "${key}=\"${!key}\" (environment variable is specified)"
            else
                declare -g "${key}=${val}"
                DEBUG "${key}=\"${val}\" (${HPCISSH_CONF})"
            fi
        done < "${HPCISSH_CONF}"
    fi

    # Use a default value if not set.

    set_param HPCISSH_DEBUG_X "no"
    # shellcheck disable=SC2154
    if [[ "${HPCISSH_DEBUG_X}" = "yes" ]]; then
        set -x
    fi
    set_param HPCISSH_DEBUG "no"
    set_param HPCISSH_QUIET "no"

    set_param USE_JWT_AGENT "yes"  # no ... use oidc-agent

    # for oidc-agent only
    set_param OIDC_AT_LEAST_VALID_TIME "180"  # 3 min.
    set_param OIDC_AGENT_FORWARD "yes"
    set_param OIDC_AGENT_CONF_NAME "hpci"
    set_param OIDC_ISSUER "https://metis.hpci.nii.ac.jp/auth/realms/HPCI"
    set_param OIDC_AGENT_USE_PW_ENV "yes"

    # for oidc-agent and jwt-agent
    set_param OIDC_USERINFO_ENDPOINT_PATH "/protocol/openid-connect/userinfo"
    set_param OIDC_USERINFO_ENDPOINT ""  # default: auto (get issuer from access token)
    set_param OIDC_USERINFO_EXPIRE "1800"  # sec. (30 min.)

    set_param HPCISSH_PORT "2222"
    set_param HPCISSH_TOKEN_INPUT "sshpass"  # sshpass or SSH_ASKPASS
    set_param HPCISSH_AUTO_LOGIN_NAME "yes"  # no ... speedup
    set_param HPCISSH_AUTO_KNOWN_HOSTS "yes"  # yes ... use KnownHostsCommand

    # ===== Parameters for commands related to hpcissh-clients =====
    # (Call set_param() to display the parameters by hpci-config-show)
    #
    # For oidc-agent
    set_param OIDC_AGENT_OPTS "--no-autoreauthenticate --no-autoload"
    # https://indigo-dc.gitbook.io/oidc-agent/configuration/directory
    set_param OIDC_CONFIG_DIR "${OIDC_CONFIG_DIR:-}"
    set_param OIDC_SOCK "${OIDC_SOCK:-}"
    set_param OIDCD_PID "${OIDCD_PID:-}"
    set_param OIDCD_PID_FILE "${OIDCD_PID_FILE:-}"
    # For jwt-agent
    #   http://oss-tsukuba.org/gfarm/share/doc/gfarm/html/en/user/auth-sasl.html
    set_param JWT_USER_PATH "${JWT_USER_PATH:-}"

    # shellcheck disable=SC2154
    : "${HPCISSH_AUTO_LOGIN_NAME}"
    # shellcheck disable=SC2154
    : "${HPCISSH_AUTO_KNOWN_HOSTS}"
    # shellcheck disable=SC2154
    : "${HPCISSH_TOKEN_INPUT}"
    # shellcheck disable=SC2154
    : "${OIDC_AGENT_USE_PW_ENV}"
    # shellcheck disable=SC2154
    : "${OIDC_USERINFO_EXPIRE}"
    # shellcheck disable=SC2154
    : "${OIDC_AT_LEAST_VALID_TIME}"
    # shellcheck disable=SC2154
    : "${OIDC_AGENT_CONF_NAME}"
    # shellcheck disable=SC2154
    : "${OIDC_USERINFO_ENDPOINT_PATH}"

    # Update global variables
    if [[ "${HPCISSH_AUTO_KNOWN_HOSTS}" = "yes" ]]; then
         SSH_BASIC_OPTS+=("${KNOWN_HOSTS_CMD[@]}")
    fi
    SSH_OPTS+=("${SSH_BASIC_OPTS[@]}" "${FORWARD_BEHAVIOR[@]}")
}

init_common() {
    if [[ "${#}" -eq 0 ]]; then
        usage
        exit 1
    fi

    set +e
    echo "${@}" | grep PreferredAuthentications > /dev/null
    local RESULT="${?}"
    set -e
    if [[ "${RESULT}" -eq 0 ]]; then
        ERROR "don't use PreferredAuthentications option."
        exit 1
    fi

    load_common_config
}

print_userinfo() {
    curl -LfsS "${_USERINFO_ENDPOINT}" \
         -H 'Content-Type:application/json;charset=utf-8' \
         -H "Authorization: Bearer ${OIDC_AT}"
}

check_and_print_local_accounts() {
    local HPCISSH_LOCAL_ACCOUNTS="${1}"

    #if jq -e '.["local-accounts"]' "$HPCISSH_LOCAL_ACCOUNTS"; then
    if grep -q \"local-accounts\" "${HPCISSH_LOCAL_ACCOUNTS}"; then
        # valid
        cat "${HPCISSH_LOCAL_ACCOUNTS}"  # output
        DEBUG "USE cached userinfo"
    else
        # invalid file
        local info
        info=$(cat "${HPCISSH_LOCAL_ACCOUNTS}")
        WARN "Invalid userinfo from ${_USERINFO_ENDPOINT}: ${info}"
        rm -f "${HPCISSH_LOCAL_ACCOUNTS}"
        # DEBUG "DELETE invalid cached userinfo"
        echo ""  # output
    fi
}

fetch_local_accounts_json() {
    set -eu
    local USE_CACHE="${1}"

    if [[ "${USE_CACHE}" = "true" ]]; then
        if [[ -f "${HPCISSH_LOCAL_ACCOUNTS}" ]]; then
            check_and_print_local_accounts "${HPCISSH_LOCAL_ACCOUNTS}"
            return 0
        else
            DEBUG "NO cached userinfo"
            # FALLTHROUGH
        fi
    fi
    local tmpfile
    tmpfile="${HPCISSH_LOCAL_ACCOUNTS}.tmp"
    touch "${tmpfile}"
    chmod 600 "${tmpfile}"
    DEBUG "DOWNLOAD userinfo"

    # shellcheck disable=SC2310
    if print_userinfo > "${tmpfile}"; then
        mv "${tmpfile}" "${HPCISSH_LOCAL_ACCOUNTS}"
        check_and_print_local_accounts "${HPCISSH_LOCAL_ACCOUNTS}"
        return 0
    else
        local rv="${?}"
        rm -f "${tmpfile}"
        return "${rv}"
    fi
}

conv_key() {
    # use SHA-256
    local val
    if type -path sha256sum &> /dev/null; then
        # DEBUG "use sha256sum"
        val=$(sha256sum)
    elif type -path openssl &> /dev/null; then
        # DEBUG "use openssl"
        val=$(openssl dgst -sha256 -r)
    elif type -path shasum &> /dev/null; then
        # DEBUG "use shasum"
        val=$(shasum -a 256)
    else
        ERROR "No sha256sum command"
        exit 1
    fi
    # Same as `echo -n "$val" | cut -d ' ' -f 1`
    echo "${val%% *}"
}

KEY_PREFIX="Z"  # avoid "value too great for base"

load_local_accounts_switch() {
    local USE_CACHE="${1}"
    local ACCMAP_LIST=()

    set +e

    # shellcheck disable=SC2312
    mapfile -t ACCMAP_LIST < <(fetch_local_accounts_json "${USE_CACHE}" \
        | jq -r '.["local-accounts"] | to_entries | .[] | .key + " " + .value' 2> /dev/null)
    # ex. ACCMAP_LIST[0]="oauth-server1.test test02"

    # If "set +e" is not used, "ACCMAP_LIST[@]: unbound variable" will occur.
    local CHECK_LIST="${ACCMAP_LIST[*]}"

    set -e
    if [[ -z "${CHECK_LIST}" ]]; then
        DEBUG "NO local-accounts"
        return 0
    fi

    unset ACCMAP
    declare -g -A ACCMAP  # global
    local key
    local value
    local FQDN
    for i in "${ACCMAP_LIST[@]}"; do
        # conv_key: keys for associative array variable of bash
        FQDN=$(echo "${i}" | cut -d ' ' -f 1)
        key="${KEY_PREFIX}$(echo "${FQDN}" | conv_key)"
        value=$(echo "${i}" | cut -d ' ' -f 2)
        ACCMAP[${key}]="${value}"
        DEBUG "ACCMAP[(${FQDN})${key}]=${ACCMAP[${key}]}"
    done
}

get_mtime() {
    if stat --version &> /dev/null; then
        # GNU stat(1)
        stat -c %Y "${1}"
    else
        # BSD, macOS
        stat -f %m "${1}"
    fi
}

load_local_accounts() {
    if [[ "${HPCISSH_AUTO_LOGIN_NAME}" != "yes" ]]; then
        DEBUG "Skip load_local_accounts"
        return
    fi
    set -eu
    local USE_CACHE

    if [[ -f "${HPCISSH_LOCAL_ACCOUNTS}" ]]; then
        local EXPIRE="${OIDC_USERINFO_EXPIRE}"
        local current_time
        local mtime
        current_time=$(date +%s)
        mtime=$(get_mtime "${HPCISSH_LOCAL_ACCOUNTS}")  # modification time
        local expired_at=$((mtime + EXPIRE))
        DEBUG current_time="${current_time}"
        DEBUG mtime="${mtime}"
        DEBUG expired_at="${expired_at}"
        if [[ "${current_time}" -le "${expired_at}" ]]; then
            DEBUG "SKIP downloading userinfo (use cache)"
            USE_CACHE=true
            load_local_accounts_switch "${USE_CACHE}"
            return
        fi
        # expired
    fi
    # update JSON file once
    # download userinfo
    USE_CACHE=false
    load_local_accounts_switch "${USE_CACHE}"
}

get_local_account() {
    local FQDN="${1}"
    local key
    DEBUG "FQDN=${FQDN}"
    key=$(echo "${FQDN}" | conv_key)
    key="${KEY_PREFIX}${key}"
    DEBUG "FQDN(sha256)=${key}"

    set +u
    echo "${ACCMAP[${key}]}"
    set -u
}

# To suppress oidc-prompt (GUI popup) for oidc-agent
set_OIDC_ENCRYPTION_PW() {
    local confirm="${1}"  # yes...Encryption

    if [[ "${OIDC_AGENT_USE_PW_ENV}" != "yes" ]]; then
        return
    fi
    # tput is included in the ncurses package
    if type tput &> /dev/null; then
        RED=$(tput setaf 1)
        CYAN=$(tput setaf 6)
        RESET=$(tput sgr0)
    else
        RED="" CYAN="" RESET=""
    fi
    while :; do
        if [[ "${confirm}" = "yes" ]]; then
            echo -n "${CYAN}Enter encryption password for account configuration '${CONF_NAME}': ${RESET}"
        else
            echo -n "${CYAN}Enter decryption password for account config '${CONF_NAME}': ${RESET}"
        fi
        read -rs OIDC_ENCRYPTION_PW
        echo
        if [[ "${confirm}" = "yes" ]]; then
            echo -n "${CYAN}Confirm encryption password: ${RESET}"
            read -rs OIDC_ENCRYPTION_PW_2
            echo
            if [[ "${OIDC_ENCRYPTION_PW}" = "${OIDC_ENCRYPTION_PW_2}" ]]; then
                break
            fi
        else
            break
        fi
        echo "${RED}Encryption passwords did not match.${RESET}"
    done
    # For "--pw-env" option of oidc-gen and oidc-add
    export OIDC_ENCRYPTION_PW
}

load_conf() {
    if [[ "${#}" -ne 4 ]]; then
        ERROR "load_conf: invalid usage"
        return 1
    fi

    local ISSUER="${1}"
    local SCOPES="${2}"
    local AUDIENCE="${3}"
    local CONF_NAME="${4}"

    # For oidc-agent
    USE_JWT_AGENT="no"

    set +e
    oidc-add -l | grep -E "^${CONF_NAME}$" > /dev/null
    local RESULT="${?}"
    set -e
    local run_oidc_gen="yes"
    local oidc_gen_reauthenticate="no"
    if [[ "${RESULT}" -eq 0 ]]; then
        # The account configuration file is found in ~/.config/oidc-agent/
        set +e
        oidc-add -a | grep -E "^${CONF_NAME}$" > /dev/null
        RESULT="${?}"
        set -e
        if [[ "${RESULT}" -ne 0 ]]; then
            # The account configuration is not loaded
            set_OIDC_ENCRYPTION_PW no
            local OIDC_ADD_OPTS=()
            local rv=1
            if [[ -n "${OIDC_ENCRYPTION_PW:-}" ]]; then
                OIDC_ADD_OPTS+=("--pw-env")
                set +e
                # Disable password prompts in oidc-add commands.
                run_quiet oidc-add "${OIDC_ADD_OPTS[@]}" "${CONF_NAME}" < /dev/null
                rv=$?
                set -e
            else
                set +e
                oidc-add "${OIDC_ADD_OPTS[@]}" "${CONF_NAME}"
                rv=$?
                set -e
            fi
            if [[ "${rv}" -eq 0 ]]; then
                # OK, loaded
                :
            else
                # Expired
                oidc_gen_reauthenticate="yes"
            fi
        fi
        if [[ "${oidc_gen_reauthenticate}" = "no" ]]; then
            get_token_ignore_expired

            # shellcheck disable=SC2310
            if is_jwt_expired; then
                # Expired
                oidc_gen_reauthenticate="yes"
            else
                # OK, loaded
                run_oidc_gen="no"
                INFO "Account configuration is loaded: ${CONF_NAME}"
            fi
        fi
    fi
    if [[ "${run_oidc_gen}" = "yes" ]]; then
        local OIDC_GEN_OPTS=()
        if [[ -z "${OIDC_ENCRYPTION_PW:-}" ]]; then
            set_OIDC_ENCRYPTION_PW yes
        fi
        if [[ -n "${OIDC_ENCRYPTION_PW:-}" ]]; then
            OIDC_GEN_OPTS+=("--pw-env")
        fi
        if [[ "${oidc_gen_reauthenticate}" = "yes" ]]; then
            OIDC_GEN_OPTS+=("--reauthenticate")
        fi
        oidc-gen --pub \
            "${OIDC_GEN_OPTS[@]}" \
            -w device \
            --issuer="${ISSUER}" \
            --scope="${SCOPES}" \
            --redirect-uri=http://localhost:8080/ \
            --aud="${AUDIENCE}" \
            "${CONF_NAME}"
    fi
}

warning_not_found_localacc() {
    local username="${USER:-}"
    if [[ -z "${username}" ]]; then
        username=$(whoami)
    fi
    WARN "Failed to find your remote username corresponding to the specified OAuth-SSH server.  Your local username (${username}) will be specified instead."
}

print_version() {
    echo "hpcissh (OAuth-SSH client for HPCI) ${VERSION}"
    ssh -V
}

print_args() {
    local arg
    for arg in "${@}"; do
        echo "${arg}"
    done
}

convert_ssh_arg() {
    local ARGV=("${@}")
    local argnum="${#ARGV[*]}"
    local maxidx=$((argnum - 1))
    local found=false

    load_local_accounts

    for i in $(seq 1 "${maxidx}"); do
        local ARG="${ARGV[${i}]}"
        case "${ARG}" in
            -*)  # is option
                continue
                ;;
            *)
                ;;
        esac
        # ARG is not a option

        # Convert the first matching host.
        localacc=$(get_local_account "${ARG}")
        if [[ -n "${localacc}" ]]; then
            found=true
            # CASE: ssh -l name name

            # ARG is hostname
            local USERHOST="${localacc}@${ARG}"
            ARGV[i]="${USERHOST}"  # update
            break
        fi
    done
    if ! "${found}"; then
        #warning_not_found_localacc
        DEBUG "unknown hpcissh server"
    fi
    print_args "${ARGV[@]}"
}

split_user_host_file() {
    local -n ref_USER="${1}"  # nameref
    local -n ref_HOST="${2}"  # nameref
    local -n ref_FILE="${3}"  # nameref
    local input="${4}"
    local command="${5}"  # scp or sftp
    local user="" host="" file=""

    if [[ "${input}" == *:* ]]; then
        # user@host:file
        host=$(echo "${input}" | cut -d':' -f1)
        file=$(echo "${input}" | cut -d':' -f2-)
        if [[ "${host}" == *@* ]]; then
            user=$(echo "${host}" | cut -d'@' -f1)
            host=$(echo "${host}" | cut -d'@' -f2-)
        fi
    else
        if [[ "${command}" = "scp" ]]; then
            user=""
            host=""
            file="${input}"
        elif [[ "${command}" = "sftp" ]]; then
            user=""
            host="${input}"
            file=""
            if [[ "${host}" == *@* ]]; then
                user=$(echo "${host}" | cut -d'@' -f1)
                host=$(echo "${host}" | cut -d'@' -f2-)
            fi
        fi
    fi
    if [[ "${HPCISSH_DEBUG:-no}" = "yes" ]]; then
        DEBUG "--- ${input} ---"
        DEBUG "_HPCISSH_USER=\"${user}\""
        DEBUG "_HPCISSH_HOST=\"${host}\""
        DEBUG "_HPCISSH_FILE=\"${file}\""
    fi
    # shellcheck disable=SC2034
    ref_USER="${user}"
    # shellcheck disable=SC2034
    ref_HOST="${host}"
    # shellcheck disable=SC2034
    ref_FILE="${file}"
}

convert_scp_arg() {
    # scp [options] file [user1@]host1:[file]
    # scp [options] [[user1@]host1:]file file
    # scp [options] [[user1@]host1:]file [[user2@]host2]:[file]
    # scp [options] [[user1@]host1:]file ... dir

    local ARGV=("${@}")
    local argnum="${#ARGV[*]}"
    if [[ "${argnum}" -lt 3 ]]; then
        echo "INVALID SYNTAX"
        return 1
    fi

    local maxidx=$((argnum - 1))
    local found=false

    load_local_accounts

    # convert from last arg
    for i in $(seq "${maxidx}" -1 1); do
        local ARG="${ARGV[${i}]}"
        case "${ARG}" in
            -*)
                break
                ;;
            *)
                ;;
        esac
        # ARG is not a option

        if [[ "${ARG}" == *:* ]]; then
            local _HPCISSH_USER="" _HPCISSH_HOST="" _HPCISSH_FILE=""
            split_user_host_file _HPCISSH_USER _HPCISSH_HOST _HPCISSH_FILE "${ARG}" scp
            if [[ -n "${_HPCISSH_HOST}" ]]; then
                if [[ -z "${_HPCISSH_USER}" ]]; then
                    _HPCISSH_USER=$(get_local_account "${_HPCISSH_HOST}")
                    if [[ -n "${_HPCISSH_USER}" ]]; then
                        found=true
                        # update
                        ARGV[i]="${_HPCISSH_USER}@${ARG}"
                    fi
                fi
            fi
        fi
    done
    if ! "${found}"; then
        #warning_not_found_localacc
        DEBUG "unknown hpcissh server"
    fi
    print_args "${ARGV[@]}"
}

convert_sftp_arg() {
    # sftp [options] [user1@]host1[:file]

    local ARGV=("${@}")
    local argnum="${#ARGV[*]}"
    if [[ "${argnum}" -lt 2 ]]; then
        echo "INVALID SYNTAX"
        return 1
    fi

    local targetidx=$((argnum - 1))
    local DST="${ARGV[${targetidx}]}"

    load_local_accounts

    if [[ "${DST}" != *:* ]]; then
        if [[ "${argnum}" -ge 3 ]]; then
            local DST2="${ARGV[targetidx - 1]}"
            if [[ "${DST2}" != -* ]]; then  # not option
                if [[ "${DST2}" == *:* ]]; then
                    # CASE: sftp host:file copied_file
                    DST="${DST2}"
                    targetidx=$((targetidx - 1))
                fi
            fi
        fi
    fi

    local found=false
    local _HPCISSH_USER="" _HPCISSH_HOST="" _HPCISSH_FILE=""
    split_user_host_file _HPCISSH_USER _HPCISSH_HOST _HPCISSH_FILE "${DST}" sftp
    if [[ -n "${_HPCISSH_HOST}" ]]; then
        if [[ -z "${_HPCISSH_USER}" ]]; then
            _HPCISSH_USER=$(get_local_account "${_HPCISSH_HOST}")
            if [[ -n "${_HPCISSH_USER}" ]]; then
                found=true
                # update
                ARGV[targetidx]="${_HPCISSH_USER}@${DST}"
            fi
        fi
    fi
    if ! "${found}"; then
        #warning_not_found_localacc
        DEBUG "unknown hpcissh server"
    fi
    print_args "${ARGV[@]}"
}

verify_hostname() {
    local RESULT="${1}"
    if [[ "${RESULT}" -eq 6 ]]; then
        ERROR "Host verification may have failed. Please check /etc/ssh/ssh_known_hosts or ~/.ssh/known_hosts"
    fi
}

pad_base64() {
    local data="${1}==="
    local count
    count=$(echo -n "${data}" | wc -c)
    count=$((count / 4 * 4))
    echo "${data}" | cut -b -"${count}"
}

decode_jwt() {
    local i
    for i in 1 2; do
        local b64
        b64=$(echo "${OIDC_AT}" | cut -d. -f "${i}")
        pad_base64 "${b64}" | base64 -d
    done
}

decode_jwt_cached() {
    echo "${OIDC_AT_DECODED}"
}

get_claim() {
    local name="${1}"
    echo "${OIDC_AT_DECODED}" | grep "\"${name}\":" | awk '{ print $2 }' | sed -e 's/[",]//g'  # " for Editor
}

check_expired() {
    local report="${1}"
    local is_expired=0
    local current
    current=$(date +%s)
    local key val sec remain=0
    while read -r key val; do
        case "${key}" in
            \"exp\":)
                sec=$(echo "${val}" | cut -d, -f 1)
                [[ "${is_expired}" -eq 0 ]] && is_expired=$((sec < current))
                remain=$((sec - current))
                break
                ;;
            # NOTE: No need to compare "iat"
            # \"iat\":|\"auth_time\":|\"nbf\":)
            #    sec=$(echo $val | cut -d, -f 1)
            #    [ $is_expired = 0 ] && is_expired=$((sec > current))
            #    ;;
            *)
                ;;
        esac
    done
    if [[ "${report}" = "true" ]]; then
        local datetime
        datetime=$(date)
        if [[ "${is_expired}" -eq 1 ]]; then
            ERROR "Access token is expired. (${datetime})"
        elif [[ "${remain}" -gt 0 ]]; then
            INFO "remaining time: ${remain} sec."
        fi
    fi
    [[ "${is_expired}" -eq 1 ]] && return 1
    return 0
}

is_jwt_expired() {
    # shellcheck disable=SC2310
    if echo "${OIDC_AT_DECODED}" | check_expired false; then
        return 1
    else
        return 0  # True ... expired
    fi
}

report_expired() {
    echo "${OIDC_AT_DECODED}"
    echo "${OIDC_AT_DECODED}" | check_expired true
}
