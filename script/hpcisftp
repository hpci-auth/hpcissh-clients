#!@bash_path@

set -eu

source ${pkglibexecdir:-@pkglibexecdir@}/hpcissh-lib

usage() {
    echo "Usage: ${0} [sftp command option] host"
    echo "NOTE: The -b option is unavailable"
}

init_common "${@}"
get_token

SFTP_CMD="${SFTP_CMD:-sftp}"

RAW_ARGV=("${SFTP_CMD}")
RAW_ARGV+=("${@}")

ARGV=()
for arg in $(convert_sftp_arg "${RAW_ARGV[@]}"); do
    ARGV+=("$arg")
done
ARGV=("${ARGV[@]:1}")

set +e
runssh "${SFTP_CMD}" -P ${HPCISSH_PORT} "${SSH_BASIC_OPTS[@]}" "${ARGV[@]}"
RESULT=${?}
verify_hostname $RESULT
set -e
exit $RESULT
