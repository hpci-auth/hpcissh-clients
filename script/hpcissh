#!@bash_path@

set -eu -o pipefail
shopt -s inherit_errexit

source "${pkglibexecdir:-@pkglibexecdir@}"/hpcissh-lib

PROGNAME=$(basename "${0}")

usage() {
    echo "Usage: ${0} [ssh command option] [user@]hostname [command]"
}

init_common "${@}"
get_token

# shellcheck disable=SC2154
: "${HPCISSH_PORT}"
# shellcheck disable=SC2154
: "${OIDC_AGENT_FORWARD}"

SSH_CMD="${SSH_CMD:-ssh}"

RAW_ARGV=("${SSH_CMD}")
RAW_ARGV+=("${@}")

ARGV=()
CONVERTED_SSH_ARG=$(convert_ssh_arg "${RAW_ARGV[@]}")
while IFS= read -r arg; do
    ARGV+=("${arg}")
done <<< "${CONVERTED_SSH_ARG}"
ARGV=("${ARGV[@]:1}")

DEBUG "ARGV=${ARGV[*]}"

# use -t for "hpcissh ... hpcissh ..."
for i in $(seq 1 "${#}");
do
    set +e
    INDEX=$((i - 1))
    echo -n "${ARGV[${INDEX}]}" | grep -E '^'"${PROGNAME}"'$' > /dev/null
    RESULT="${?}"
    set -e
    if [[ "${RESULT}" -eq 0 ]];
    then
        SSH_OPTS+=("-t")
        break
    fi

    set +e
    echo -n "${ARGV[${INDEX}]}" | grep -E '^.*/'"${PROGNAME}"'$' > /dev/null
    RESULT="${?}"
    set -e
    if [[ "${RESULT}" -eq 0 ]];
    then
        SSH_OPTS+=("-t")
        break
    fi
done

if [[ -n "${OIDC_SOCK:-}" ]];
then  # use oidc-agent
    if [[ "${OIDC_AGENT_FORWARD}" == "yes" ]];
    then
        SUB_CLAIM=$(get_claim sub)

        # hpcissh have to forward oidc-agent's unix domain socket to /tmp
        # on remote host as ssh can't create a parent directory of
        # forwarded unix domain socket
        REMOTE_OIDC_SOCK=$(mktemp -u /tmp/oidc-agent."${SUB_CLAIM}".XXXXXXXXXXXX.sock)
        SSH_OPTS+=("-R" "${REMOTE_OIDC_SOCK}:${OIDC_SOCK}")
        SSH_OPTS+=("-o" "SendEnv=OIDC_SOCK")
        OIDC_SOCK="${REMOTE_OIDC_SOCK}"
    fi
    SSH_OPTS+=("-o" "SendEnv=OIDC_AGENT_CONF_NAME")
fi

SSH_OPTS+=("-p" "${HPCISSH_PORT}")

set +e
runssh "${SSH_CMD}" "${SSH_OPTS[@]}" "${ARGV[@]}"
RESULT="${?}"
verify_hostname "${RESULT}"
#if [ ${RESULT} -eq 6 ]; then
#    "${SSH_CMD}" "${SSH_OPTS[@]}" "${ARGV[@]}"
#fi
set -e
exit "${RESULT}"
