#!@bash_path@

set -eu

CA_PUB_FILE="@pkgdatadir@/known_hosts-HPCI-SSH_CA.txt"
GLOBAL_KNOWN_HOSTS="/etc/ssh/ssh_known_hosts"
USER_KNOWN_HOSTS="${HOME}/.ssh/known_hosts"

usage() {
    local exit_code="${1:-1}"  # 1: error
    if [[ "${exit_code}" -ne 0 ]]; then
        exec 1>&2
    fi
    echo "Usage: ${0} --system [--update]"
    echo "       ${0} --user [--update]"
    echo "  --system: Append SSH CA to ${GLOBAL_KNOWN_HOSTS} (requires root privileges)"
    echo "  --user  : Append SSH CA to ${USER_KNOWN_HOSTS}"
    echo "  --update: Actually append the CA key (without this, only shows the content)"
    echo "  --help  : Show this help message"
    exit "${exit_code}"
}

TARGET=""
DO_UPDATE=false

for arg in "${@}"; do
    case "${arg}" in
        --system)
            if [[ -n "${TARGET}" ]]; then usage; fi
            TARGET="${GLOBAL_KNOWN_HOSTS}"
            ;;
        --user)
            if [[ -n "${TARGET}" ]]; then usage; fi
            TARGET="${USER_KNOWN_HOSTS}"
            ;;
        --update) DO_UPDATE=true ;;
        -h|--help) usage 0 ;;
        *) usage ;;
    esac
done

if [[ -z "${TARGET}" ]]; then usage; fi

if [[ ! -f "${CA_PUB_FILE}" ]]; then
    echo "ERROR: CA public key not found at ${CA_PUB_FILE}" >&2
    exit 1
fi

# Check if already present (matches if a line starts with the CA key content)
if [[ -f "${TARGET}" ]] && awk 'NR==FNR {pat=$0; next} index($0, pat) == 1 {f=1; exit} END {exit !f}' "${CA_PUB_FILE}" "${TARGET}"; then
    echo "INFO: SSH CA is already present in ${TARGET}. No changes needed."
    exit 0
fi

if [[ "${DO_UPDATE}" = "true" ]]; then
    echo "INFO: Appending SSH CA to ${TARGET} ..."

    # Backup
    if [[ -f "${TARGET}" ]]; then
        BACKUP_BASE="${TARGET}.backup.hpcissh"
        BACKUP_FILE="${BACKUP_BASE}.1"
        COUNT=1
        while [[ -f "${BACKUP_FILE}" ]]; do
            COUNT=$((COUNT + 1))
            BACKUP_FILE="${BACKUP_BASE}.${COUNT}"
        done

        if [[ "${TARGET}" = "${GLOBAL_KNOWN_HOSTS}" ]]; then
            cp -p "${TARGET}" "${BACKUP_FILE}"
        else
            cp -p "${TARGET}" "${BACKUP_FILE}"
        fi
        echo "INFO: Backup created: ${BACKUP_FILE} (You can delete it if not needed)"
    fi

    if [[ "${TARGET}" = "${GLOBAL_KNOWN_HOSTS}" ]]; then
        TARGET_DIR="$(dirname "${TARGET}")"
        if [[ ! -e "${TARGET_DIR}" ]]; then
            echo "INFO: Running: mkdir -p \"${TARGET_DIR}\" && chmod 755 \"${TARGET_DIR}\""
            mkdir -p "${TARGET_DIR}"
            chmod 755 "${TARGET_DIR}"
        fi
        if [[ ! -e "${TARGET}" ]]; then
            echo "INFO: Running: touch \"${TARGET}\" && chmod 644 \"${TARGET}\""
            touch "${TARGET}"
            chmod 644 "${TARGET}"
        fi
        echo "INFO: Running: cat \"${CA_PUB_FILE}\" >> \"${TARGET}\""
        cat "${CA_PUB_FILE}" >> "${TARGET}"
    else
        DOTSSH_DIR="$(dirname "${TARGET}")"
        if [[ ! -e "${DOTSSH_DIR}" ]]; then
             echo "INFO: Running: mkdir -p \"${DOTSSH_DIR}\" && chmod 700 \"${DOTSSH_DIR}\""
             mkdir -p "${DOTSSH_DIR}"
             chmod 700 "${DOTSSH_DIR}"
        fi
        if [[ ! -e "${TARGET}" ]]; then
            echo "INFO: Running: touch \"${TARGET}\" && chmod 600 \"${TARGET}\""
            touch "${TARGET}"
            chmod 600 "${TARGET}"
        fi
        echo "INFO: Running: cat \"${CA_PUB_FILE}\" >> \"${TARGET}\""
        cat "${CA_PUB_FILE}" >> "${TARGET}"
    fi
    echo "INFO: Done."
else
    echo "--- Dry-run: The following line will be appended to ${TARGET} ---"
    cat "${CA_PUB_FILE}"
    echo "----------------------------------------------------------------"
    echo "To apply this change, run with the --update flag:"

    if [[ "${TARGET}" = "${GLOBAL_KNOWN_HOSTS}" ]]; then
        echo "  ${0} --system --update"
    else
        echo "  ${0} --user --update"
    fi
fi
