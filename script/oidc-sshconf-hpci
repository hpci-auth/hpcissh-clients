#!@bash_path@

set -eu

source "${pkglibexecdir:-@pkglibexecdir@}"/hpcissh-lib

load_common_config

# shellcheck disable=SC2154
ISSUER="${OIDC_ISSUER}"
SCOPES="openid hpci offline_access scitokens"
AUDIENCE="hpci"

if [[ "${#}" -eq 0 ]];
then
    CONF_NAME="${OIDC_AGENT_CONF_NAME}"
else
    CONF_NAME="${1}"
fi

exec "${bindir:-@bindir@}"/oidc-sshconf "${ISSUER}" "${SCOPES}" "${AUDIENCE}" "${CONF_NAME}"
